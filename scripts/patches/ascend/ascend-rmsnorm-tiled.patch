+    void *y, const void *x, const void *weight, size_t tokens, size_t heads,
+    ptrdiff_t y_token, ptrdiff_t x_token, float epsilon, void *stream) {
+    if (!tokens) return INFINI_STATUS_SUCCESS;
+    const size_t blocks = tokens < 64 ? tokens : 64;
